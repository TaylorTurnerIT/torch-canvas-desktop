{
  "name": "torch-canvas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Tauri desktop port of Torch Canvas by Jesse Roberts",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node build.js",
    "test": "node test.js",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build --bundles app",
    "desktop:prepare": "python3 scripts/prepare-web.py",
    "desktop:test": "node --test tests/*.test.cjs",
    "desktop:test:ui": "playwright test",
    "desktop:test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0"
  }
}
