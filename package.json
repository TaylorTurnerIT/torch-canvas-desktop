{
  "name": "torch-canvas-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Tauri desktop port of Torch Canvas by Jesse Roberts",
  "scripts": {
    "start": "tauri dev",
    "build": "tauri build --bundles app",
    "tauri": "tauri",
    "prepare:web": "python3 scripts/prepare-web.py",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "playwright test",
    "check:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0"
  }
}
